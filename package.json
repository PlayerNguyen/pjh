{
  "name": "pjh",
  "module": "index.ts",
  "type": "module",
  "private": true,
  "license": "MIT",
  "author": "PlayerNguyen",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PlayerNguyen/pjh.git"
  },
  "homepage": "https://github.com/PlayerNguyen/pjh#readme",
  "bugs": {
    "url": "https://github.com/PlayerNguyen/pjh/issues"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "bun run --filter './apps/*' dev",
    "dev:core": "bun run --cwd apps/core dev",
    "dev:dashboard": "bun run --cwd apps/dashboard dev",
    "test": "bun run --cwd apps/core test",
    "build": "bun run --cwd apps/dashboard build",
    "start:core": "bun run --cwd apps/core start",
    "start:dashboard": "node apps/dashboard/build/index.js",
    "test:memory": "bun scripts/check-memory.ts",
    "check": "bun run typecheck && bun run --cwd apps/dashboard check",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@types/bun": "latest"
  },
  "peerDependencies": {
    "typescript": "^7"
  }
}
